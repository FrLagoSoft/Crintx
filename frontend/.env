# COMMITTED to git: shared, non-secret values only (EAS cloud builds read this file).
# Every EXPO_PUBLIC_* value is readable inside the APK, so never put a server secret here.
# Per-machine overrides and keys go in .env.local (git-ignored). See .env.example.

# The backend's base URL: the AWS API Gateway invoke URL, including the stage if it has one,
# e.g. https://abc123.execute-api.us-east-1.amazonaws.com/prod   (no trailing slash needed).
# The app appends /api/test, /api/v1/locations/... to it.
EXPO_PUBLIC_API_URL=https://PASTE-API-GATEWAY-URL-HERE
