# COMMITTED to git: shared, non-secret values only (EAS cloud builds read this file).
# Every EXPO_PUBLIC_* value is readable inside the APK, so never put a server secret here.
# Per-machine overrides and keys go in .env.local (git-ignored). See .env.example.

# The backend's base URL (Marcos's ECS task). The app appends /api/test, /api/v1/locations/... to it.
# Note: a Fargate task's public IP changes when it restarts or redeploys; update this if the
# app says "Server offline". Plain http:// works in dev builds; release/preview APKs need
# usesCleartextTraffic (or HTTPS) to reach it.
EXPO_PUBLIC_API_URL=http://3.86.241.3:8080
