# COMMITTED to git: shared, non-secret defaults only.
# Keys and per-machine values go in .env.local (git-ignored), which overrides this file.
# Every EXPO_PUBLIC_* value is readable inside the APK, so never put a server secret here.

# Where the Spring Boot backend runs. Use a LAN IP (NOT localhost: on a phone that's the phone).
EXPO_PUBLIC_API_URL=http://192.168.1.50:8080
# For the demo, your deployed server:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
