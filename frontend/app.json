{
  "expo": {
    "name": "Crintx",
    "slug": "crintx",
    "scheme": "crintx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFDAB3",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "bluetooth-central",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1116"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.frlagosoft.crintx",
      "permissions": [
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/loading-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFDAB3"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Crintx uses Bluetooth to buzz your ESP32 tags."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Crintx records where each buzz happened so you can find your devices."
        }
      ],
      "llama.rn"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d2f89a78-3c32-43ae-9672-b85e2c272689"
      }
    },
    "owner": "auntdespo"
  }
}
