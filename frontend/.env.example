# Template for frontend/.env.local (git-ignored). Copy it, fill in, restart with: npx expo start --dev-client -c
# Every EXPO_PUBLIC_* value is readable inside the APK, so never put a server secret here.

# Optional: point THIS machine at a different backend than the shared one in .env,
# e.g. a server on your laptop: http://<your-LAN-IP>:8080  (not localhost: on a phone that's the phone)
# EXPO_PUBLIC_API_URL=

# Optional: CARTO basemaps key (carto.com/basemaps/apikey). Empty = plain OpenStreetMap tiles.
# For EAS cloud builds, set it with: eas env:set --name EXPO_PUBLIC_CARTO_KEY --value "..." --environment preview --environment development --visibility sensitive
EXPO_PUBLIC_CARTO_KEY=
