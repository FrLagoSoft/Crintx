# Backend secrets template. Copy to .env (git-ignored) in the repo root and fill in.
# Read by `mvnw spring-boot:run` (via spring.config.import) and by docker compose.
# On AWS ECS, set these in the task definition instead (secrets via Secrets Manager).

# Local testing without MongoDB: in-memory (data is lost when the server stops)
STORAGE_TYPE=in-memory
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/crintx

# Narrator Mode (ElevenLabs text-to-speech)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   (Sarah; free plans can only use "premade" voices)
